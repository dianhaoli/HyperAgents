     return "\n".join(parts)
 
 
+def build_revision_prompt(inputs, candidate):
+    """Ask the second attempt to verify and, when necessary, repair the first grid."""
+    prompt = build_prompt(inputs)
+    if candidate is None:
+        context = (
+            "The first attempt did not produce a parseable grid. Solve the puzzle again, "
+            "carefully deriving the rule from every demonstration."
+        )
+    else:
+        context = (
+            "A first attempt proposed this candidate output grid (it may be wrong):\n"
+            f"{json.dumps(candidate)}\n\n"
+            "Treat it only as a hypothesis. Independently infer the transformation from the "
+            "demonstration pairs and check that it explains every example. Compare the test "
+            "input with the candidate cell by cell; correct any inconsistent or missing changes. "
+            "If the candidate is fully consistent, returning it unchanged is appropriate."
+        )
+    return prompt + "\n\nSecond-attempt verification:\n" + context + "\n" + (
+        "Return only the final grid using the required <answer> tags."
+    )
+
+
 def _valid(g):
     return (isinstance(g, list) and len(g) > 0 and all(isinstance(r, list) and len(r) > 0 for r in g)
             and len({len(r) for r in g}) == 1
