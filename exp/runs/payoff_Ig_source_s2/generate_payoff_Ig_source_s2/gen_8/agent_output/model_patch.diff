+def build_revision_prompt(inputs, candidate):
+    """Use the second model call to independently verify the first candidate."""
+    prompt = build_prompt(inputs)
+    if candidate is None:
+        context = (
+            "The first attempt did not produce a parseable grid. Solve the puzzle again, "
+            "carefully deriving the rule from every demonstration."
+        )
+    else:
+        context = (
+            "A first attempt proposed a candidate output, but it may be wrong. First derive the "
+            "rule from the training pairs without relying on that candidate, and verify that the "
+            "rule reproduces every demonstrated output. Then use the candidate only as a check: "
+            "compare it with the test input and the independently derived rule, correcting any "
+            "inconsistent or missing changes. If the candidate follows the verified rule, it is "
+            "fine to return it unchanged. The candidate is:\n"
+            f"{json.dumps(candidate)}"
+        )
+    return prompt + "\n\nSecond-attempt verification:\n" + context + "\n" + (
+        "Return only the final grid using the required <answer> tags."
+    )
