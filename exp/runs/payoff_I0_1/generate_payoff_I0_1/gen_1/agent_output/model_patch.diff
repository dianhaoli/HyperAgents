+def build_verification_prompt(inputs, candidate):
+    """Ask the remaining model call to audit a candidate against all demonstrations."""
+    return build_prompt(inputs) + (
+        "\n\nINDEPENDENT VERIFICATION (do not assume the candidate is correct):\n"
+        f"The first attempt proposed this test output: {json.dumps(candidate)}\n"
+        "Infer the transformation again from the training pairs. Check that the proposed rule "
+        "accounts for every changed cell in every example, and apply that rule to the test grid. "
+        "If the candidate is fully consistent, return it; otherwise return the corrected grid. "
+        "Check the output dimensions and every row before responding. End with exactly one grid "
+        "inside <answer></answer> tags as a JSON list of rows, with nothing else inside the tags."
+    )
+
+
