+def _dihedral_grids(grid):
+    """Return the eight rotations/reflections of a rectangular grid."""
+    result = []
+    current = [row[:] for row in grid]
+    for _ in range(4):
+        result.append(current)
+        result.append([row[::-1] for row in current])
+        current = [list(row) for row in zip(*current[::-1])]
+    return result
+
+
+def find_symmetry_candidate(inputs):
+    """Find an unambiguous D4 transform with a consistent global color map.
+
+    Return a candidate only when every train-consistent transform yields the same
+    test grid. Unseen test colors are allowed only when the learned map is identity.
+    """
+    train, test = inputs.get("train", []), inputs.get("test_input")
+    if not train or not _valid(test):
+        return None
+    predictions = set()
+    for symmetry in range(8):
+        mapping = {}
+        valid = True
+        for pair in train:
+            source, target = pair.get("input"), pair.get("output")
+            if not _valid(source) or not _valid(target):
+                valid = False
+                break
+            source = _dihedral_grids(source)[symmetry]
+            if len(source) != len(target) or len(source[0]) != len(target[0]):
+                valid = False
+                break
+            for src_row, dst_row in zip(source, target):
+                for src, dst in zip(src_row, dst_row):
+                    if src in mapping and mapping[src] != dst:
+                        valid = False
+                        break
+                    mapping[src] = dst
+                if not valid:
+                    break
+            if not valid:
+                break
+        if not valid:
+            continue
+        oriented = _dihedral_grids(test)[symmetry]
+        colors = {value for row in oriented for value in row}
+        if any(value not in mapping for value in colors) and any(
+            src != dst for src, dst in mapping.items()
+        ):
+            continue
+        prediction = [[mapping.get(value, value) for value in row] for row in oriented]
+        if _valid(prediction):
+            predictions.add(tuple(tuple(row) for row in prediction))
+    if len(predictions) != 1:
+        return None
+    return [list(row) for row in next(iter(predictions))]
+
