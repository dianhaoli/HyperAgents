+def _dihedral_grids(grid):
+    """Yield the eight rotations/reflections of a grid without mutating it."""
+    current = [row[:] for row in grid]
+    for _ in range(4):
+        yield current
+        yield [row[::-1] for row in current]
+        # Clockwise rotation; works for rectangular as well as square grids.
+        current = [list(row) for row in zip(*current[::-1])]
+
+
+def find_exact_symmetry_candidate(inputs):
+    """Find a unique train-consistent D4 + global color-map prediction, if any.
+
+    This deliberately searches only a small, interpretable family of rules. It returns
+    nothing when viable rules disagree on the test, so it cannot silently choose between
+    ambiguous transformations.
+    """
+    train = inputs.get("train", [])
+    test = inputs.get("test_input")
+    if not train or not _valid(test):
+        return None
+
+    predictions = set()
+    for symmetry in range(8):
+        color_map = {}
+        viable = True
+        for pair in train:
+            source, target = pair.get("input"), pair.get("output")
+            if not _valid(source) or not _valid(target):
+                viable = False
+                break
+            oriented = list(_dihedral_grids(source))[symmetry]
+            if len(oriented) != len(target) or len(oriented[0]) != len(target[0]):
+                viable = False
+                break
+            for src_row, dst_row in zip(oriented, target):
+                for src, dst in zip(src_row, dst_row):
+                    if src in color_map and color_map[src] != dst:
+                        viable = False
+                        break
+                    color_map[src] = dst
+                if not viable:
+                    break
+            if not viable:
+                break
+        if not viable:
+            continue
+
+        oriented_test = list(_dihedral_grids(test))[symmetry]
+        test_colors = {value for row in oriented_test for value in row}
+        # Unseen colors are safe to leave unchanged only when the examples imply that
+        # colors are preserved globally; otherwise their replacement is unknowable.
+        if any(value not in color_map for value in test_colors) and any(
+            source != target for source, target in color_map.items()
+        ):
+            continue
+        prediction = [[color_map.get(value, value) for value in row] for row in oriented_test]
+        if _valid(prediction):
+            predictions.add(tuple(tuple(row) for row in prediction))
+
+    if len(predictions) != 1:
+        return None
+    return [list(row) for row in next(iter(predictions))]
+
