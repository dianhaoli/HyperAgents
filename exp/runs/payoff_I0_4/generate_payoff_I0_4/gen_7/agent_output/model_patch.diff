+def find_translation_candidate(inputs):
+    """Find an exact, fixed translation of a grid on its background canvas.
+
+    This intentionally handles only translations which reproduce every demonstration
+    exactly. The canvas is not wrapped: cells shifted off the edge must be background,
+    and newly exposed cells are filled with the uniquely most frequent input color.
+    """
+    train, test = inputs.get("train", []), inputs.get("test_input")
+    if not train or not _valid(test):
+        return None
+
+    def background(grid):
+        counts = {}
+        for row in grid:
+            for color in row:
+                counts[color] = counts.get(color, 0) + 1
+        largest = max(counts.values())
+        winners = [color for color, count in counts.items() if count == largest]
+        return winners[0] if len(winners) == 1 else None
+
+    hypotheses = set()
+    # The same orientation and pixel offset must explain all examples.
+    for symmetry in range(8):
+        for dy in range(-len(test), len(test) + 1):
+            for dx in range(-len(test[0]), len(test[0]) + 1):
+                if dx == 0 and dy == 0:
+                    continue
+                mapping = {}
+                valid = True
+                for pair in train:
+                    source, target = pair.get("input"), pair.get("output")
+                    if not _valid(source) or not _valid(target):
+                        valid = False
+                        break
+                    source = _dihedral_grids(source)[symmetry]
+                    height, width = len(target), len(target[0])
+                    if len(source) != height or len(source[0]) != width:
+                        valid = False
+                        break
+                    bg = background(source)
+                    if bg is None:
+                        valid = False
+                        break
+                    covered = set()
+                    for r, row in enumerate(source):
+                        for c, color in enumerate(row):
+                            rr, cc = r + dy, c + dx
+                            if not (0 <= rr < height and 0 <= cc < width):
+                                if color != bg:
+                                    valid = False
+                                continue
+                            covered.add((rr, cc))
+                            out_color = target[rr][cc]
+                            if color in mapping and mapping[color] != out_color:
+                                valid = False
+                                break
+                            mapping[color] = out_color
+                        if not valid:
+                            break
+                    if not valid or any(target[r][c] != bg for r in range(height)
+                                        for c in range(width) if (r, c) not in covered):
+                        valid = False
+                        break
+                if not valid:
+                    continue
+
+                oriented = _dihedral_grids(test)[symmetry]
+                bg = background(oriented)
+                if bg is None:
+                    continue
+                colors = {color for row in oriented for color in row}
+                if any(color not in mapping for color in colors) and any(
+                    src != dst for src, dst in mapping.items()
+                ):
+                    continue
+                height, width = len(oriented), len(oriented[0])
+                prediction = [[bg for _ in range(width)] for _ in range(height)]
+                for r, row in enumerate(oriented):
+                    for c, color in enumerate(row):
+                        rr, cc = r + dy, c + dx
+                        if 0 <= rr < height and 0 <= cc < width:
+                            prediction[rr][cc] = mapping.get(color, color)
+                        elif color != bg:
+                            valid = False
+                            break
+                    if not valid:
+                        break
+                if valid and _valid(prediction):
+                    hypotheses.add(tuple(tuple(row) for row in prediction))
+
+    if len(hypotheses) != 1:
+        return None
+    return [list(row) for row in next(iter(hypotheses))]
+
