+class EvaluationTrendTests(unittest.TestCase):
+    def _write_report(self, root, generation, data):
+        path = os.path.join(root, f"gen_{generation}", "arc_eval", "report.json")
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        with open(path, "w", encoding="utf-8") as stream:
+            json.dump(data, stream)
+
+    def test_summarizes_task_regressions_recoveries_and_recurrence(self):
+        with tempfile.TemporaryDirectory() as root:
+            self._write_report(root, 1, {
+                "overall_accuracy": 0.75, "total": 3,
+                "per_task_score": {"regressed": 1.0, "recovered": 0.0, "repeat": 0.0},
+            })
+            self._write_report(root, 2, {
+                "overall_accuracy": 0.75, "total": 3,
+                "per_task_score": {"regressed": 0.0, "recovered": 1.0, "repeat": 0.0},
+            })
+            summary = summarize_evaluation_history(root)
+            self.assertIn("newly partial/failed: regressed", summary)
+            self.assertIn("recovered: recovered", summary)
+            self.assertIn("repeat (2/2 generations)", summary)
+
+    def test_ignores_invalid_and_non_finite_scores(self):
+        with tempfile.TemporaryDirectory() as root:
+            self._write_report(root, 1, {
+                "overall_accuracy": 0.5, "total": 1,
+                "per_task_score": {"huge": 10 ** 1000, "valid": 0.0},
+            })
+            self._write_report(root, 2, {
+                "overall_accuracy": float("inf"), "total": 1,
+                "per_task_score": {"valid": 1.0},
+            })
+            summary = summarize_evaluation_history(root)
+            self.assertIn("gen_1 [arc_eval]: 0.500", summary)
+            self.assertNotIn("huge", summary)
+            self.assertNotIn("gen_2 [arc_eval]", summary)
+
+
 if __name__ == "__main__":
     unittest.main()
