+    def test_reports_transitions_recurring_failures_and_per_input_diagnostics(self):
+        with tempfile.TemporaryDirectory() as root:
+            reports = {
+                "gen_1/arc_eval/report.json": {
+                    "overall_accuracy": 0.5, "total": 3,
+                    "per_task_score": {"regressed": 1.0, "recovered": 0.0, "repeat": 0.0},
+                },
+                "gen_2/arc_eval/report.json": {
+                    "overall_accuracy": 0.75, "total": 3,
+                    "per_task_score": {"regressed": 0.0, "recovered": 1.0, "repeat": 0.0},
+                },
+            }
+            for relative, data in reports.items():
+                path = os.path.join(root, relative)
+                os.makedirs(os.path.dirname(path), exist_ok=True)
+                with open(path, "w", encoding="utf-8") as stream:
+                    json.dump(data, stream)
+            prediction_path = os.path.join(root, "gen_2", "arc_eval", "predictions.json")
+            with open(prediction_path, "w", encoding="utf-8") as stream:
+                json.dump([
+                    {"task_id": "regressed", "test_input": 0, "solved": False,
+                     "n_answers_returned": 2, "agent_error": None,
+                     "wrong_answers": [[[1]], [[2]]]},
+                    {"task_id": "regressed", "test_input": 1, "solved": True,
+                     "n_answers_returned": 1, "agent_error": None, "wrong_answers": []},
