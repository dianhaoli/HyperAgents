+            for source_row, target_row in zip(transformed, output):
+                for source, target in zip(source_row, target_row):
+                    if source in color_map and color_map[source] != target:
+                        consistent = False
+                        break
+                    color_map[source] = target
+                if not consistent:
+                    break
+            if not consistent:
