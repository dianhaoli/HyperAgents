+def build_verification_prompt(inputs, candidate):
+    """Ask the second attempt to check the first candidate against the demonstrations."""
+    return (
+        build_prompt(inputs)
+        + "\n\nA first attempt proposed this test output candidate:\n"
+        + json.dumps(candidate)
+        + "\nIndependently infer the transformation from all demonstration pairs. Check whether this exact candidate follows the rule, including its dimensions and cell values. "
+        + "If it is wrong, correct it; if it is consistent, return it unchanged. Return only the final grid inside <answer></answer> tags as a JSON list of rows."
+    )
+
+
 def _valid(g):
