+def strip_python_bytecode_from_patch(patch_text):
+    """Drop generated Python bytecode blocks from a candidate source patch."""
+    kept_blocks = []
+    block = []
+    keep_block = True
+    for line in patch_text.splitlines(keepends=True):
+        if line.startswith("diff --git "):
+            if block and keep_block:
+                kept_blocks.extend(block)
+            block = [line]
+            fields = line.split()
+            paths = fields[2:4]
+            keep_block = not any(
+                "__pycache__" in path.split("/", 1)[-1].split("/")
+                or path.removeprefix("a/").removeprefix("b/").endswith((".pyc", ".pyo"))
+                for path in paths
+            )
+        elif block:
+            block.append(line)
+        else:
+            # Keep any patch preamble before its first file block.
+            kept_blocks.append(line)
+    if block and keep_block:
+        kept_blocks.extend(block)
+    return "".join(kept_blocks)
+
