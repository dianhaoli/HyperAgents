+def _build_evaluation_summary(eval_path, exclude_genid=None):
+    """Create a compact report index for the self-improving agent."""
+    score_keys = (
+        "overall_accuracy", "accuracy", "exact_match_accuracy",
+        "success_rate", "resolved_rate", "score",
+    )
+    reports = []
+    if not eval_path or not os.path.isdir(eval_path):
+        return ""
+
+    for root, _, filenames in os.walk(eval_path):
+        if "report.json" not in filenames:
+            continue
+        try:
+            with open(os.path.join(root, "report.json"), encoding="utf-8") as f:
+                report = json.load(f)
+        except (OSError, ValueError):
+            continue
+        if not isinstance(report, dict):
+            continue
+        metric = next(
+            ((key, report[key]) for key in score_keys
+             if isinstance(report.get(key), (int, float))
+             and not isinstance(report.get(key), bool)
+             and math.isfinite(report[key])),
+            None,
+        )
+        if metric is None:
+            continue
+
+        relative_parts = os.path.relpath(root, eval_path).split(os.sep)
+        generation = next((part for part in relative_parts if part.startswith("gen_")), "unknown")
+        if exclude_genid is not None and generation == f"gen_{exclude_genid}":
+            continue
+        report_kind = "/".join(part for part in relative_parts if part != generation) or "report"
+        failed = report.get("question_ids_failed")
+        if not isinstance(failed, list):
+            per_task = report.get("per_task_score")
+            failed = ([task for task, value in per_task.items()
+                       if isinstance(value, (int, float)) and value < 1]
+                      if isinstance(per_task, dict) else [])
+        reports.append((report_kind, generation, metric[0], metric[1], failed))
+
+    if not reports:
+        return ""
+
+    def gen_order(generation):
+        if generation == "gen_initial":
+            return -1
+        try:
+            return int(generation.removeprefix("gen_"))
+        except ValueError:
+            return 10**9
+
+    reports.sort(key=lambda row: (row[0], gen_order(row[1])))
+    lines = [
+        "# Prior evaluation summary",
+        "",
+        "Compare scores only within the same report path/domain and split.",
+        "Use these measured results to identify gains and regressions before changing the agent.",
+    ]
+    for report_kind, generation, metric, score, failed in reports:
+        line = f"- {generation} / {report_kind}: {metric}={score:g}"
+        if failed:
+            line += "; failed task IDs: " + ", ".join(str(task) for task in failed[:12])
+            if len(failed) > 12:
+                line += f" (+{len(failed) - 12} more)"
+        lines.append(line)
+    return "\n".join(lines) + "\n"
+
+
