+def grid_change_audit(before, after):
+    """Describe every changed/added/removed cell, grouped by value transition."""
+    before_h, after_h = len(before), len(after)
+    before_w = len(before[0]) if before_h else 0
+    after_w = len(after[0]) if after_h else 0
+    groups = {}
+    for r in range(max(before_h, after_h)):
+        for c in range(max(before_w, after_w)):
+            old = before[r][c] if r < before_h and c < before_w else None
+            new = after[r][c] if r < after_h and c < after_w else None
+            if old != new:
+                groups.setdefault((old, new), []).append((r, c))
+
+    dimensions = f"dimensions {before_h}x{before_w} -> {after_h}x{after_w}"
+    if not groups:
+        return f"{dimensions}; no cell-value changes"
+
+    details = []
+    for (old, new), coords in groups.items():
+        if old is None:
+            transition = f"added {new}"
+        elif new is None:
+            transition = f"removed {old}"
+        else:
+            transition = f"{old}->{new}"
+        positions = ", ".join(f"({r},{c})" for r, c in coords)
+        details.append(f"{transition}: {len(coords)} cell(s) at {positions}")
+    return f"{dimensions}; " + "; ".join(details)
+
+
