+def build_review_prompt(inputs, candidate):
+    """Build a second-pass prompt that checks a candidate against the demonstrations."""
+    prompt = build_prompt(inputs)
+    review = (
+        "A first attempt proposed this test output grid:\n"
+        + json.dumps(candidate)
+        + "\nTreat it as a hypothesis, not as an answer. Independently infer the rule from every "
+        "training pair, check this grid against that rule, and correct it if needed. If it is "
+        "already correct, return it unchanged. Give the final output grid for the test input."
+    )
+    return prompt.replace("Give the output grid for the test input.", review, 1)
+
